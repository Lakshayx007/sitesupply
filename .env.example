# Copy to .env.local (never committed) to use the AI assistant with `npm run dev`.
# On Vercel, add the same variable under Project Settings → Environment Variables.
GROQ_API_KEY=
# Optional: GROQ_MODEL=<a Groq model id> to try first. Default: openai/gpt-oss-120b, falling back to openai/gpt-oss-20b.
# Optional: ALLOWED_ORIGINS=https://your-domain.com (comma-separated) if the site is also served from another domain.
